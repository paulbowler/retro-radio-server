# Copy this file to .env and set a management password before starting.
RETRO_ADMIN_USER=admin
RETRO_ADMIN_PASSWORD=
RETRO_PUBLIC_URL=http://pure.wifiradiofrontier.com

# Optional comma-separated LAN audio URLs or origin-wide /* rules, pinned at startup. MP3/AAC only.
# RETRO_LAN_STREAM_URLS=https://station.home.paulbowler.co.uk/*
RETRO_LAN_STREAM_URLS=

# Optional administrator fallback only: music servers are discovered automatically.
# Exact UPnP device-description URL (not the MinimServer settings page).
RETRO_MUSIC_SERVER_URL=
# Set true when HTTPS playback is known to work on your radios.
RETRO_RADIO_HTTPS=false
# Convert FLAC to MP3 only when no compatible native resource is available.
RETRO_MUSIC_TRANSCODE=true

# Optional online DJ. Keep your API key only in .env, never in Git.
RETRO_AGENT_FM=false
OPENAI_API_KEY=
RETRO_AGENT_TEXT_MODEL=gpt-6.1-sol
# Optional local research uses web search; enable it in app Settings.
RETRO_AGENT_LOCAL_MODEL=gpt-4.1-mini
RETRO_AGENT_SPEECH_MODEL=gpt-4o-mini-tts
RETRO_AGENT_VOICE=ballad
# Optional custom voice delivery instructions; blank uses a relaxed British DJ.
RETRO_AGENT_DELIVERY=

# Enables the destructive database rebuild in Settings. Development only.
RETRO_DEVELOPMENT=false
